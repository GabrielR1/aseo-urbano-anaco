# ============================================================
# EcoRuta / Aseo Urbano Anaco - Variables de entorno de ejemplo
# Copia este archivo como .env y ajusta los valores reales.
# Nunca subas el archivo .env a un repositorio.
# ============================================================

# Django
SECRET_KEY=cambia-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Base de datos
# En local se usa SQLite si DATABASE_URL está vacío y USE_POSTGRES=False.
USE_POSTGRES=False
DB_NAME=ecoruta_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgres://usuario:clave@host:5432/base_de_datos

# CORS: solo necesario si sirves la app Flutter Web desde otro dominio.
CORS_ALLOWED_ORIGINS=

# Claves iniciales del catálogo de demostración (cámbialas antes de producción).
ADMIN_INITIAL_PASSWORD=admin123
CHOFER_INITIAL_PASSWORD=chofer123

# Producción (Render)
# SECURE_SSL_REDIRECT=True
