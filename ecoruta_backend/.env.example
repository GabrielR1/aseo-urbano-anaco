# ============================================================
# Aseo Urbano Anaco - Variables de entorno de ejemplo
# Copia este archivo como .env y coloca tus valores reales.
# Nunca subas el archivo .env al repositorio.
# ============================================================

# Django
SECRET_KEY=cambia-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Base de datos PostgreSQL (única base de datos del sistema)
# Opción recomendada: pega aquí la "External Database URL" de Render (ecoruta-anaco-db)
DATABASE_URL=postgresql://usuario:clave@dpg-xxxxx-a.oregon-postgres.render.com/ecoruta_db

# Alternativa si usas PostgreSQL local (solo si DATABASE_URL está vacío):
# DB_NAME=ecoruta_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# CORS: orígenes permitidos en producción (opcional para Flutter Web)
CORS_ALLOWED_ORIGINS=

# Claves iniciales del catálogo base (cámbialas antes de producción)
ADMIN_INITIAL_PASSWORD=admin123
CHOFER_INITIAL_PASSWORD=chofer123

# Correo SMTP para recuperación de contraseña (ej. Gmail con Contraseña de Aplicación)
# Si EMAIL_HOST se deja vacío, los correos se imprimen en la consola local.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-contrasena-de-aplicacion
DEFAULT_FROM_EMAIL=Aseo Urbano Anaco <tu-correo@gmail.com>
